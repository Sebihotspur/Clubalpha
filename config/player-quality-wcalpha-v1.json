      "drp": {"weight": 1.8, "direction": "inverted", "label": "Times dribbled past per 90"},
      "pace": {"weight": 1.5, "direction": "positive", "label": "Pace or recovery measure"},
      "clrblk": {"weight": 1.3, "direction": "positive", "label": "Clearances plus blocks per 90"},
      "passpct": {"weight": 1.2, "direction": "positive", "label": "Pass completion percentage"},
      "vers": {"weight": 1.0, "direction": "positive", "label": "Versatility"}
    },
    "FB": {
      "inherits": "CB"
    }
