{
  "version": "clubalpha_historical_fixtures_v2_deep",
  "source": "FotMob normalized competitive match details across five PL and UCL seasons",
  "purpose": "Simulation-oriented historical context with slow competition baselines and strongly decayed matchup evidence",
  "history_inputs": {
    "include_deep_history": true,
    "deep_history_dir": "data/processed/deep_history"
  },
  "target_fixtures": {
    "source_scopes": [
      "premier_league_current",
      "champions_league_qualification_2026_27"
    ],
    "horizon_days": 14
  },
  "performance_metrics": [
    "goals",
    "expected_goals",
    "shots_on_target",
    "big_chances"
  ],
  "normalisation": {
    "method": "competition-season peer sample z-score plus locked league-quality offset",
    "minimum_peer_values": 20,
    "z_cap": 3.0,
    "separate_seasons": true
  },
  "league_strength": {
    "config_path": "config/player-quality-clubalpha-v2.json",
    "policy_key": "league_quality",
    "note": "Reuse the locked Player Quality v2 league ladder so promoted and cross-league clubs are not treated as equivalent competition environments."
  },
  "recency": {
    "team_half_life_days": 180,
    "team_max_age_days": 1095,
    "direct_half_life_days": 270,
    "direct_max_age_days": 1095,
    "competition_baseline_half_life_days": 730
  },
  "source_weights": {
    "premier_league_previous": 1.0,
    "champions_league_previous": 1.0,
    "domestic_history_previous": 1.0,
    "premier_league_current": 1.0,
    "champions_league_qualification_2026_27": 1.0,
    "default": 1.0
  },
  "competition_baseline": {
    "enabled": true,
    "prior_weighted_matches": 50.0,
    "purpose": "Estimate home advantage, score variance, covariance, xG environment, over-2.5, BTTS, and draw rates for later simulation calibration."
  },
  "venue_history": {
    "prior_weighted_matches": 5.0
  },
  "direct_history": {
    "prior_weighted_matches": 5.0,
    "same_venue_multiplier": 1.25,
    "maximum_signal_share": 0.15,
    "recent_meetings_limit": 10
  },
  "quality": {
    "minimum_venue_confidence": 0.5,
    "minimum_direct_confidence": 0.15
  },
  "decision_boundaries": {
    "probability_ready": false,
    "market_ready": false,
    "capital_deployment_ready": false
  }
}
